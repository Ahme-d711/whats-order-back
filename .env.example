DATABASE_URL="postgresql://attendance_user:change-me@localhost:5432/attendance?schema=public"
PORT=3000
NODE_ENV=development
# Comma-separated browser origins only when the API is called cross-origin.
CORS_ORIGINS=
# Required in production. Protects GET/DELETE /api/admin/attendance-registrations.
# Send as X-Admin-Api-Key (or Authorization: Bearer <key>) from a trusted server/BFF.
ADMIN_API_KEY=
# WA-Pilot credentials used to send broadcast reminders. Optional at startup;
# saves still succeed and each undelivered message is recorded as failed.
WASEL_API_TOKEN=
WASEL_INSTANCE_ID=
