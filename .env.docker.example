POSTGRES_DB=attendance
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Docker Compose uses the internal service name "postgres".
# URL-encode special characters in the username or password.
DATABASE_URL=postgresql://attendance_user:replace-with-a-long-random-password@postgres:5432/attendance?schema=public

BACKEND_PORT=3000
CORS_ORIGINS=http://localhost:3001
ADMIN_API_KEY=replace-with-a-long-random-admin-api-key
WASEL_API_TOKEN=replace-with-the-wapilot-api-token
WASEL_INSTANCE_ID=replace-with-the-wapilot-instance-id
IMAGE_TAG=local
